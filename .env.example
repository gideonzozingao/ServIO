PORT=3000
NODE_ENV=development
# Runtime role (DML only, subject to RLS)
DATABASE_URL=postgresql://servio_app:app@localhost:5432/servio
# Better Auth role (auth tables only, no RLS)
AUTH_DATABASE_URL=postgresql://servio_auth:auth@localhost:5432/servio
# Owner role, used only by prisma migrate (prisma.config.ts)
MIGRATION_DATABASE_URL=postgresql://servio_owner:owner@localhost:5432/servio
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars-xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
PIN_PEPPER=change-me-to-a-long-random-server-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
STAFF_SESSION_HOURS=12
# Admin web app origin, used to build links in emails (verify, reset, invitations)
APP_URL=http://localhost:5173
# Public owner sign-up (POST /api/v1/registration)
SELF_SIGNUP_ENABLED=true
# Optional: proxy IPs/CIDRs if X-Forwarded-For chains must be walked
TRUSTED_PROXIES=
